# bKash Tokenized Checkout sandbox credentials (issued by bKash for your merchant account)
BKASH_APP_KEY=your_sandbox_app_key
BKASH_APP_SECRET=your_sandbox_app_secret
BKASH_USERNAME=your_sandbox_username
BKASH_PASSWORD=your_sandbox_password

# "sandbox" or "production"
BKASH_ENVIRONMENT=sandbox

# Used by the FastAPI example to build callback/IPN URLs
PUBLIC_BASE_URL=http://localhost:8000
